# このファイルを .env という名前でコピーして、値を埋める。
# .env は git に入らない設定にしてある。

# アプリの .env.local と同じ2つ
JISUI_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
JISUI_SUPABASE_KEY=sb_publishable_...

# アプリにログインするときと同じメールアドレスとパスワード。
# サービスキー(sb_secret_)ではなくユーザーとしてログインするので、
# RLS がそのまま効く(自分の世帯のデータしか触れない)。
JISUI_EMAIL=you@example.com
JISUI_PASSWORD=
