# Supabase の Project Settings → API から取得して .env.local にコピーする。
# この2つが未設定でもアプリは起動する(この端末だけで完結する「ローカルモード」になる)。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# フェーズ3(レシート読み取り)で使う。クライアントには絶対に出さないので NEXT_PUBLIC_ を付けない。
# ANTHROPIC_API_KEY=sk-ant-...
